###############################################################################
# CICA-GPRO — Configuration Docker
#
# 1. Copiez ce fichier : cp .env.docker .env
# 2. Modifiez les valeurs selon votre environnement
# 3. Lancez : docker compose up -d --build
#
# Pour PostgreSQL : voir docs/docker-guide.md
###############################################################################

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=CICA-GPRO
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR
APP_MAINTENANCE_DRIVER=file

# Mode : selfhosted (open source) ou saas (multi-org avec ROOT)
GPRO_MODE=selfhosted

# ── Ports (changez si occupes sur le serveur) ────────────────────────────────
APP_PORT=8080
DB_PORT=3306
PHPMYADMIN_PORT=8081
PGADMIN_PORT=8082
REDIS_PORT=6379
# REVERB_PORT=6001

# ── Base de donnees ──────────────────────────────────────────────────────────
# MySQL (par defaut)
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=cica_gpro
DB_USERNAME=gpro
DB_PASSWORD=gpro_secret_2026
DB_ROOT_PASSWORD=root_secret_2026

# PostgreSQL (decommenter et commenter MySQL ci-dessus)
# DB_CONNECTION=pgsql
# DB_HOST=postgres
# DB_PORT=5432
# DB_DATABASE=cica_gpro
# DB_USERNAME=gpro
# DB_PASSWORD=gpro_secret_2026

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PASSWORD=gpro_redis_2026
REDIS_PORT=6379

# ── Cache & Queue ────────────────────────────────────────────────────────────
BROADCAST_DRIVER=log
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# ── Email ────────────────────────────────────────────────────────────────────
# En production, configurez votre SMTP
MAIL_MAILER=log
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@cica-gpro.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ── pgAdmin (si PostgreSQL) ──────────────────────────────────────────────────
PGADMIN_EMAIL=admin@cica-gpro.com
PGADMIN_PASSWORD=pgadmin_2026

# ── WebSockets (optionnel — desactive par defaut) ────────────────────────────
# Pour activer : BROADCAST_DRIVER=reverb, decommenter le service reverb dans docker-compose.yml
REVERB_APP_ID=gpro-prod
REVERB_APP_KEY=gpro-prod-key
REVERB_APP_SECRET=gpro-prod-secret
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ── Plugins ──────────────────────────────────────────────────────────────────
GPRO_PLUGINS_ENABLED=true

# ── Social Auth (optionnel) ──────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL="${APP_URL}/auth/google/callback"

# ── IA (optionnel) ───────────────────────────────────────────────────────────
GROQ_API_KEY=
