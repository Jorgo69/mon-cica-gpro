# =============================================================================
# CICA-GPRO — Configuration MySQL (production)
# =============================================================================
# Copiez ce fichier vers .env : cp .env.example.mysql .env
# Puis : php artisan key:generate
#
# Creez la base de donnees :
#   mysql -u root -p
#   CREATE DATABASE cica_gpro CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#   CREATE USER 'gpro'@'localhost' IDENTIFIED BY 'CHANGEZ_CE_MOT_DE_PASSE';
#   GRANT ALL PRIVILEGES ON cica_gpro.* TO 'gpro'@'localhost';
#   FLUSH PRIVILEGES;
# =============================================================================

APP_NAME=CICA-GPRO
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://votre-domaine.com
APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR
APP_MAINTENANCE_DRIVER=file

# Mode : saas (multi-org, ROOT, plans) ou selfhosted (open source, tout illimite)
GPRO_MODE=selfhosted

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# --- Base de donnees MySQL ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cica_gpro
DB_USERNAME=gpro
DB_PASSWORD=CHANGEZ_CE_MOT_DE_PASSE

# --- Services ---
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Redis (optionnel mais recommande en prod pour cache + queue + session)
# Si Redis est installe, changez :
#   CACHE_DRIVER=redis
#   QUEUE_CONNECTION=redis
#   SESSION_DRIVER=redis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Email (OBLIGATOIRE en production) ---
# Gmail : activez "App Passwords" dans Google Account > Security
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=votre-email@gmail.com
MAIL_PASSWORD=xxxx-xxxx-xxxx-xxxx
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@votre-domaine.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- WebSockets (optionnel — necessite VPS) ---
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=
REVERB_PORT=
REVERB_SCHEME=

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# --- Social Auth (laisser vide = desactive) ---
# Google : https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL="${APP_URL}/auth/google/callback"

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URL="${APP_URL}/auth/facebook/callback"

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URL="${APP_URL}/auth/microsoft/callback"

# --- Firebase Push (optionnel) ---
FIREBASE_CREDENTIALS=
FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID="${FIREBASE_PROJECT_ID}"
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=

# --- IA (optionnel) ---
GROQ_API_KEY=
GEMINI_API_KEY=

# --- Payment (optionnel) ---
PAYMENT_GATEWAY_URL=
PAYMENT_GATEWAY_NAME=
PAYMENT_CONTACT_WHATSAPP=
PAYMENT_CONTACT_EMAIL=
