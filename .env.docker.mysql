###############################################################################
# CICA-GPRO — Docker avec MySQL + phpMyAdmin
#
# NE PAS COPIER ce fichier vers .env !
# Ce fichier est utilise UNIQUEMENT par docker-compose.
#
# Usage :
#   docker compose --env-file .env.docker.mysql up -d --build
#
# Identifiants par defaut :
#   MySQL User  : gpro / gpro_secret_2026
#   MySQL Root  : root / root_secret_2026
#   phpMyAdmin  : http://localhost:8081
#   Application : http://localhost:8090
###############################################################################

# ── Application ──
APP_NAME=CICA-GPRO
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8090
APP_PORT=8090
GPRO_MODE=selfhosted

# ── Base de donnees MySQL ──
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=cica_gpro
DB_USERNAME=gpro
DB_PASSWORD=gpro_secret_2026
DB_ROOT_PASSWORD=root_secret_2026

# ── Redis ──
REDIS_HOST=redis
REDIS_PASSWORD=gpro_redis_2026
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

# ── Email (log par defaut, configurer SMTP en prod) ──
MAIL_MAILER=log

# ── Broadcast (log = desactive) ──
BROADCAST_DRIVER=log

# ── phpMyAdmin ──
PHPMYADMIN_PORT=8081
