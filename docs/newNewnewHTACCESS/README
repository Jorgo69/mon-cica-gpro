# ================================================
# .htaccess OPTIMISÉ POUR LARAVEL SUR LWS
# Localisation : /htdocs/.htaccess (domaine principal campuschine.org)
# ================================================

<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # 1. Définit la racine pour LWS
    RewriteBase /

    # 2. Redirection vers le dossier public
    # Si la requête ne commence pas déjà par /public/
    RewriteCond %{REQUEST_URI} !^/public/
    
    # UNIQUEMENT pour le domaine principal (pas les sous-domaines)
    RewriteCond %{HTTP_HOST} ^(www\.)?campuschine\.org$ [NC]
    
    # Rediriger tout vers le dossier public/ (syntaxe LWS)
    RewriteRule ^(.*)$ public/$1 [L]
    
    # ------------------------------------------------
    # Sécurité : Bloquer l'accès aux fichiers sensibles
    # ------------------------------------------------
    
    # Bloquer l'accès au fichier .env
    RewriteRule ^\.env$ - [F,L]
    
    # Bloquer les dossiers sensibles
    RewriteRule ^config/ - [F,L]
    RewriteRule ^vendor/ - [F,L]
    RewriteRule ^storage/(?!app/public) - [F,L]
    
    # Bloquer l'exécution de fichiers PHP à la racine
    RewriteRule ^(?!public/).*\.php$ - [F,L]
</IfModule>

# ================================================
# Sécurité supplémentaire
# ================================================

Options -Indexes

<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<FilesMatch "^\.(?!well-known)">
    Order allow,deny
    Deny from all
</FilesMatch>

<FilesMatch "\.(bak|config|sql|fla|psd|ini|log|sh|inc|swp|dist|lock)$">
    Order allow,deny
    Deny from all
</FilesMatch>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
</IfModule>
