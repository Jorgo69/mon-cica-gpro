# =============================================================================
# CICA-GPRO — Configuration SQLite (dev local / petite instance)
# =============================================================================
# Copiez ce fichier vers .env : cp .env.example.sqlite .env
# Puis : php artisan key:generate
# =============================================================================

APP_NAME=CICA-GPRO
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR
APP_MAINTENANCE_DRIVER=file

# Mode : saas (multi-org, ROOT, plans) ou selfhosted (open source, tout illimite)
GPRO_MODE=selfhosted

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Base de donnees SQLite ---
# Creez le fichier : touch database/database.sqlite
DB_CONNECTION=sqlite

# --- Services ---
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Email ---
# Dev : log (pas d'envoi reel)
# Prod : smtp (Gmail, Mailgun, etc.)
MAIL_MAILER=log
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@cica-gpro.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- WebSockets (optionnel) ---
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=
REVERB_PORT=
REVERB_SCHEME=

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# --- Social Auth (laisser vide = desactive) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL="${APP_URL}/auth/google/callback"

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URL="${APP_URL}/auth/facebook/callback"

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URL="${APP_URL}/auth/microsoft/callback"

# --- Firebase Push (optionnel) ---
FIREBASE_CREDENTIALS=
FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID="${FIREBASE_PROJECT_ID}"
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=

# --- IA (optionnel) ---
# Groq : gratuit, sans restriction geo (https://console.groq.com/keys)
GROQ_API_KEY=
# Gemini : bloque dans certains pays africains
GEMINI_API_KEY=

# --- Payment (optionnel) ---
PAYMENT_GATEWAY_URL=
PAYMENT_GATEWAY_NAME=
PAYMENT_CONTACT_WHATSAPP=
PAYMENT_CONTACT_EMAIL=
