###############################################################################
# CICA-GPRO — Docker avec PostgreSQL + pgAdmin
#
# NE PAS COPIER ce fichier vers .env !
# Ce fichier est utilise UNIQUEMENT par docker-compose.
#
# ⚠️  CHANGEZ TOUS LES MOTS DE PASSE AVANT DE DEPLOYER EN PRODUCTION !
#
# Usage :
#   docker compose --env-file .env.docker.postgres -f docker-compose.yml -f docker-compose.postgres.yml up -d --build
#
# Identifiants par defaut :
#   PostgreSQL  : gpro / CHANGEZ_MOI
#   pgAdmin     : admin@cica-gpro.com / CHANGEZ_MOI
#   pgAdmin     : http://localhost:8082
#   Application : http://localhost:8090
###############################################################################

# ── Application ──
APP_NAME=CICA-GPRO
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8090
APP_PORT=8090
GPRO_MODE=selfhosted

# ── Base de donnees PostgreSQL ──
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=cica_gpro
DB_USERNAME=gpro
DB_PASSWORD=CHANGEZ_MOI

# ── Redis ──
REDIS_HOST=redis
REDIS_PASSWORD=CHANGEZ_MOI_REDIS
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

# ── Email (log par defaut, configurer SMTP en prod) ──
MAIL_MAILER=log

# ── Broadcast (log = desactive) ──
BROADCAST_DRIVER=log

# ── pgAdmin ──
PGADMIN_PORT=8082
PGADMIN_EMAIL=admin@cica-gpro.com
PGADMIN_PASSWORD=CHANGEZ_MOI_PGADMIN
