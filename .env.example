APP_NAME=CICA-GPRO
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR
APP_MAINTENANCE_DRIVER=file

# Mode : saas (multi-org, ROOT, plans payants) ou selfhosted (open source, tout illimite)
GPRO_MODE=selfhosted

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# MySQL / PostgreSQL :
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=cica_gpro
# DB_USERNAME=root
# DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Email
# Dev local : MAIL_MAILER=log (pas besoin de serveur SMTP)
# Dev avec Mailpit : MAIL_HOST=127.0.0.1, MAIL_PORT=1025
# Prod avec Gmail SMTP :
MAIL_MAILER=log
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@cica-gpro.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# WebSockets / Temps reel (optionnel — desactive par defaut)
# Pour activer : remplir les valeurs + BROADCAST_DRIVER=reverb + php artisan reverb:start
# Necessite un VPS ou serveur dedie (pas de mutualise)
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=
REVERB_PORT=
REVERB_SCHEME=

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Webhook secret (pour les deployements CI/CD)
WEBHOOK_SECRET=changeme

# Social Auth (laisser vide pour desactiver un provider)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL="${APP_URL}/auth/google/callback"

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URL="${APP_URL}/auth/facebook/callback"

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URL="${APP_URL}/auth/microsoft/callback"

# Firebase (Push Notifications FCM — optionnel)
# Telecharger le fichier JSON Service Account depuis la console Firebase
# et le placer dans storage/app/firebase-credentials.json
FIREBASE_CREDENTIALS=
FIREBASE_PROJECT_ID=

# Cle publique VAPID pour Web Push (Firebase Console > Cloud Messaging > Web Push certificates)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID="${FIREBASE_PROJECT_ID}"
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=

# IA (optionnel — au moins un provider pour activer l'assistant IA)
# Groq : gratuit, sans restriction geo (https://console.groq.com/keys)
GROQ_API_KEY=
# Gemini : (https://aistudio.google.com/apikey) — bloque dans certains pays africains
GEMINI_API_KEY=

# Payment Gateway (optionnel — laisser vide = paiement manuel uniquement)
# Exemples: FedaPay, Kkiapay, PayDunya
PAYMENT_GATEWAY_URL=
PAYMENT_GATEWAY_NAME=
PAYMENT_CONTACT_WHATSAPP=
PAYMENT_CONTACT_EMAIL=
