APP_NAME=CICA-GPRO
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://cica-pro.campuschine.org

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Pour dev local : utiliser Mailpit (MAIL_HOST=mailpit, MAIL_PORT=1025)
# Pour prod avec Gmail SMTP :
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=votre-email@gmail.com
MAIL_PASSWORD=votre-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@cica-gpro.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

WEBHOOK_SECRET="VOTRE_TOKEN_ALEATOIRE"

# Social Auth (laisser vide pour desactiver un provider)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL="${APP_URL}/auth/google/callback"

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URL="${APP_URL}/auth/facebook/callback"

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URL="${APP_URL}/auth/microsoft/callback"

# Firebase (Push Notifications FCM)
# Telecharger le fichier JSON Service Account depuis la console Firebase
# et le placer dans storage/app/firebase-credentials.json
FIREBASE_CREDENTIALS="${FIREBASE_CREDENTIALS}"
FIREBASE_PROJECT_ID=

# Cle publique VAPID pour Web Push (Firebase Console > Cloud Messaging > Web Push certificates)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID="${FIREBASE_PROJECT_ID}"
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=

# AI (Groq gratuit, pas de restriction geo : https://console.groq.com/keys)
GROQ_API_KEY=

# AI fallback (Gemini : https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Payment Gateway (laisser vide = paiement manuel uniquement)
# Exemples: FedaPay, Kkiapay, PayDunya
PAYMENT_GATEWAY_URL=
PAYMENT_GATEWAY_NAME=
PAYMENT_CONTACT_WHATSAPP=+22997000000
PAYMENT_CONTACT_EMAIL=contact@cica-gpro.com